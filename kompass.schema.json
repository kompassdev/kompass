{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kompassdev/kompass/main/kompass.schema.json",
  "title": "Kompass Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_comment": {
      "type": "string"
    },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prApprove": {
          "type": "boolean",
          "description": "Whether PR review workflows may submit approvals instead of five-star review comments"
        },
        "validation": {
          "type": "array",
          "description": "Validation guidance lines rendered into command templates",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ask": {
          "$ref": "#/$defs/commandConfig"
        },
        "branch": {
          "$ref": "#/$defs/commandConfig"
        },
        "branch/inline": {
          "$ref": "#/$defs/commandConfig"
        },
        "commit": {
          "$ref": "#/$defs/commandConfig"
        },
        "commit/inline": {
          "$ref": "#/$defs/commandConfig"
        },
        "commit-and-push": {
          "$ref": "#/$defs/commandConfig"
        },
        "commit-and-push/inline": {
          "$ref": "#/$defs/commandConfig"
        },
        "dev": {
          "$ref": "#/$defs/commandConfig"
        },
        "learn": {
          "$ref": "#/$defs/commandConfig"
        },
        "merge": {
          "$ref": "#/$defs/commandConfig"
        },
        "pr/create": {
          "$ref": "#/$defs/commandConfig"
        },
        "pr/create/inline": {
          "$ref": "#/$defs/commandConfig"
        },
        "pr/fix": {
          "$ref": "#/$defs/commandConfig"
        },
        "pr/fix/loop": {
          "$ref": "#/$defs/commandConfig"
        },
        "pr/review": {
          "$ref": "#/$defs/commandConfig"
        },
        "review": {
          "$ref": "#/$defs/commandConfig"
        },
        "skill/create": {
          "$ref": "#/$defs/commandConfig"
        },
        "skill/optimize": {
          "$ref": "#/$defs/commandConfig"
        },
        "ship": {
          "$ref": "#/$defs/commandConfig"
        },
        "ship/inline": {
          "$ref": "#/$defs/commandConfig"
        },
        "rmslop": {
          "$ref": "#/$defs/commandConfig"
        },
        "todo": {
          "$ref": "#/$defs/commandConfig"
        },
        "ticket/ask": {
          "$ref": "#/$defs/commandConfig"
        },
        "ticket/create": {
          "$ref": "#/$defs/commandConfig"
        },
        "ticket/dev": {
          "$ref": "#/$defs/commandConfig"
        },
        "ticket/plan": {
          "$ref": "#/$defs/commandConfig"
        },
        "ticket/plan-and-sync": {
          "$ref": "#/$defs/commandConfig"
        },
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ask",
              "branch",
              "branch/inline",
              "commit",
              "commit/inline",
              "commit-and-push",
              "commit-and-push/inline",
              "dev",
              "learn",
              "merge",
              "pr/create",
              "pr/create/inline",
              "pr/fix",
              "pr/fix/loop",
              "pr/review",
              "review",
              "skill/create",
              "skill/optimize",
              "ship",
              "ship/inline",
              "rmslop",
              "todo",
              "ticket/ask",
              "ticket/create",
              "ticket/dev",
              "ticket/plan",
              "ticket/plan-and-sync"
            ]
          },
          "uniqueItems": true,
          "deprecated": true
        },
        "templates": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "ask",
              "branch",
              "branch/inline",
              "commit",
              "commit/inline",
              "commit-and-push",
              "commit-and-push/inline",
              "dev",
              "learn",
              "merge",
              "pr/create",
              "pr/create/inline",
              "pr/fix",
              "pr/fix/loop",
              "pr/review",
              "review",
              "skill/create",
              "skill/optimize",
              "ship",
              "ship/inline",
              "rmslop",
              "todo",
              "ticket/ask",
              "ticket/create",
              "ticket/dev",
              "ticket/plan",
              "ticket/plan-and-sync"
            ]
          },
          "additionalProperties": {
            "type": "string"
          },
          "deprecated": true
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker": {
          "$ref": "#/$defs/agentConfig"
        },
        "planner": {
          "$ref": "#/$defs/agentConfig"
        },
        "reviewer": {
          "$ref": "#/$defs/agentConfig"
        },
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["worker", "planner", "reviewer"]
          },
          "uniqueItems": true,
          "deprecated": true
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changes_load": {
          "$ref": "#/$defs/toolConfig"
        },
        "pr_load": {
          "$ref": "#/$defs/toolConfig"
        },
        "pr_load_review": {
          "$ref": "#/$defs/toolConfig"
        },
        "pr_sync": {
          "$ref": "#/$defs/toolConfig"
        },
        "ticket_sync": {
          "$ref": "#/$defs/toolConfig"
        },
        "ticket_load": {
          "$ref": "#/$defs/toolConfig"
        },
        "worktree_list": {
          "$ref": "#/$defs/toolConfig"
        },
        "session_create": {
          "$ref": "#/$defs/toolConfig"
        },
        "session_list": {
          "$ref": "#/$defs/toolConfig"
        },
        "session_read": {
          "$ref": "#/$defs/toolConfig"
        },
        "session_send": {
          "$ref": "#/$defs/toolConfig"
        },
        "session_wait": {
          "$ref": "#/$defs/toolConfig"
        },
        "session_interrupt": {
          "$ref": "#/$defs/toolConfig"
        },
        "worktree_remove": {
          "$ref": "#/$defs/toolConfig"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "change-summary": {
          "$ref": "#/$defs/componentConfig"
        },
        "branch": {
          "$ref": "#/$defs/componentConfig"
        },
        "changes-summary": {
          "$ref": "#/$defs/componentConfig"
        },
        "commit": {
          "$ref": "#/$defs/componentConfig"
        },
        "dev-flow": {
          "$ref": "#/$defs/componentConfig"
        },
        "load-pr": {
          "$ref": "#/$defs/componentConfig"
        },
        "load-ticket": {
          "$ref": "#/$defs/componentConfig"
        },
        "pr-create": {
          "$ref": "#/$defs/componentConfig"
        },
        "pr-branch-update": {
          "$ref": "#/$defs/componentConfig"
        },
        "pr-fix": {
          "$ref": "#/$defs/componentConfig"
        },
        "push": {
          "$ref": "#/$defs/componentConfig"
        },
        "skill-authoring": {
          "$ref": "#/$defs/componentConfig"
        },
        "ticket-planning": {
          "$ref": "#/$defs/componentConfig"
        },
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["branch", "change-summary", "changes-summary", "commit", "dev-flow", "load-pr", "load-ticket", "pr-create", "pr-branch-update", "pr-fix", "push", "skill-authoring", "ticket-planning"]
          },
          "uniqueItems": true,
          "deprecated": true
        },
        "paths": {
          "type": "object",
          "propertyNames": {
            "enum": ["branch", "change-summary", "changes-summary", "commit", "dev-flow", "load-pr", "load-ticket", "pr-create", "pr-branch-update", "pr-fix", "push", "skill-authoring", "ticket-planning"]
          },
          "additionalProperties": {
            "type": "string"
          },
          "deprecated": true
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseBranch": {
          "type": "string"
        },
        "agentMode": {
          "type": "string",
          "enum": ["subagent", "primary", "all"],
          "deprecated": true
        }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opencode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agentMode": {
              "type": "string",
              "enum": ["subagent", "primary", "all"]
            },
            "navigator": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean", "default": false },
                "maxConcurrentSessions": { "type": "integer", "minimum": 1, "maximum": 8, "default": 8 },
                "maxReadChars": { "type": "integer", "minimum": 1, "default": 20000 },
                "maxOutputCharsPerItem": { "type": "integer", "minimum": 1, "default": 4000 },
                "maxWaitMs": { "type": "integer", "minimum": 1, "default": 120000 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "agentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "promptPath": {
          "type": "string"
        },
        "permission": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "agentConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "promptPath": {
          "type": "string"
        },
        "permission": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "commandConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "componentConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolName": {
      "type": "string",
      "enum": [
        "changes_load",
        "pr_load",
        "pr_load_review",
        "pr_sync",
        "ticket_sync",
        "ticket_load",
        "worktree_list",
        "session_create",
        "session_list",
        "session_read",
        "session_send",
        "session_wait",
        "session_interrupt",
        "worktree_remove"
      ]
    }
  }
}
